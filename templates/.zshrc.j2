# This file is auto-generated by ansible, do not change this file directly
# instead make changes to ~/.zshrc.personal.before or ~/.zshrc.personal.after

# ZSH setup
export ZSH=$HOME/.oh-my-zsh
ZSH_THEME="robbyrussell"
plugins=(git kubectl)
DISABLE_UNTRACKED_FILES_DIRTY="true"
ZSH_DISABLE_COMPFIX=true

# Load personal pre oh-my-zsh init config which should be stored in ~/.zshrc.personal.before
# E.g. setting ZSH theme etc
if [ -f ~/.zshrc.personal.before ]; then . ~/.zshrc.personal.before; fi

# Load Oh My Zsh
source $ZSH/oh-my-zsh.sh

# Load personal ZSH config which should be stored in ~/.zshrc.personal.after
# Most ZSH config e.g. aliases etc goes here
if [ -f ~/.zshrc.personal.after ]; then . ~/.zshrc.personal.after; fi

# mise - manages node, ruby, rust versions
eval "$(~/.local/bin/mise activate zsh)"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac

# Claude Code (native install) and other user binaries
export PATH="$HOME/.local/bin:$PATH"

# OpenCode (native install)
export PATH="$HOME/.opencode/bin:$PATH"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# postgresql@18 (keg-only)
export PATH="/opt/homebrew/opt/postgresql@18/bin:$PATH"

# Google Cloud SDK
if [ -f "/opt/homebrew/share/google-cloud-sdk/path.zsh.inc" ]; then . "/opt/homebrew/share/google-cloud-sdk/path.zsh.inc"; fi
if [ -f "/opt/homebrew/share/google-cloud-sdk/completion.zsh.inc" ]; then . "/opt/homebrew/share/google-cloud-sdk/completion.zsh.inc"; fi
